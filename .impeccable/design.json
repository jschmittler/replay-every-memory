      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Filter media\"><button class=\"ds-filter\" type=\"button\" aria-pressed=\"true\">All<span>6</span></button><button class=\"ds-filter\" type=\"button\" aria-pressed=\"false\">Videos<span>0</span></button></div>",
      "css": ".ds-filters{display:flex;gap:.6rem;flex-wrap:wrap}.ds-filter{font-family:var(--body,'EuroStyle',sans-serif);font-weight:400;line-height:1.5;font-synthesis:none;background:transparent;color:var(--ink,#15313e);display:flex;gap:.65rem;align-items:center;min-height:44px;border:0;border-radius:999px;padding:.6rem 1rem;font-size:1rem;cursor:pointer;transition:background .2s}.ds-filter span{font-size:.8rem}.ds-filter:hover{background:var(--cream,#f5f0e4)}.ds-filter[aria-pressed=true]{background:var(--navy,#091e2a);color:var(--paper,#fffdf7)}@media(max-width:760px){.ds-filters{gap:.2rem}.ds-filter{padding:.55rem .8rem;font-size:.95rem}}@media(max-width:360px){.ds-filter{padding-inline:.65rem}}@media(forced-colors:active){.ds-filter{border:1px solid ButtonText}}.ds-button:focus-visible,.ds-text-link:focus-visible,.ds-nav a:focus-visible,.ds-filter:focus-visible{outline:3px solid #ad470c;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button,.ds-text-link .ds-arrow,.ds-nav a:after,.ds-filter{animation:none!important;transition:none!important}}"
