      "html": "<a class=\"ds-button\" href=\"#trash-dash\">Meet Trash Dash <svg class=\"ds-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-button{font-family:var(--body,'EuroStyle',sans-serif);font-weight:400;line-height:1.5;font-synthesis:none;display:inline-flex;gap:1.5rem;min-height:54px;align-items:center;justify-content:center;background:var(--navy,#091e2a);color:var(--paper,#fffdf7);border:0;border-radius:12px;padding:.9rem 1.35rem;text-decoration:none;font-size:1.08rem;transition:background .2s,transform .2s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-button:hover{background:var(--navy-soft,#163847);transform:translateY(-2px)}.ds-button:active{transform:translateY(0)}.ds-arrow{display:block;width:1.3rem;height:1.3rem;flex-shrink:0}.ds-button:focus-visible,.ds-text-link:focus-visible,.ds-nav a:focus-visible,.ds-filter:focus-visible,.ds-download:focus-visible{outline:3px solid #ad470c;outline-offset:5px}@media(max-width:760px){.ds-button{font-size:1rem;min-height:50px;padding:.8rem 1.15rem}}@media(forced-colors:active){.ds-button{border:1px solid ButtonText}}@media(prefers-reduced-motion:reduce){.ds-button,.ds-text-link .ds-arrow,.ds-nav a:after,.ds-filter{animation:none!important;transition:none!important}}"
