---
import StudioImage from '../components/StudioImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import credits from '../data/studio-team.json';
---
<BaseLayout title="About Us — ReplayEveryMemory Studio" description="Meet James, Emily, Matilda, and Ramona: the family of makers behind ReplayEveryMemory Studio. Big imaginations, a hands-on spirit, and a shared love of play.">
  <section class="about-opening section"><div class="container about-opening-grid"><div><h1>A small studio.<br /><span>A whole lot<br />of heart.</span></h1><p class="lede">We’re ReplayEveryMemory Studio.<br />A family turning “what if?” into “let’s try.”</p></div><div class="about-brand"><StudioImage src="/assets/studio-logo.png" alt="ReplayEveryMemory — Dreams with a start button" previewWidth={950} /><p>Homegrown. Hands-on. Made together.</p></div></div></section>
  <section class="container about-origin section"><h2>We wanted to make<br />something of our own.</h2><div><p class="lede">A world to get lost in.<br />An adventure to remember.<br />Something we could build together.</p><p>That’s the idea behind ReplayEveryMemory. We’re a homegrown studio with a DIY spirit: learning by doing, following our curiosity, and putting a little of ourselves into the things we make.</p><p>Each of us brings a different imagination to the work. Stories, characters, music, and all those little “what if?” moments become part of the same world.</p><p>Our first game is Trash Dash. It’s the beginning of a bigger creative journey, and we’re glad you’re here for it.</p><a class="text-link" href="/games">Get to know Trash Dash <Arrow /></a></div></section>
  <section class="section team-section" id="team" aria-labelledby="team-heading"><div class="container"><div class="section-heading"><h2 id="team-heading">Meet the team.</h2><p>Four imaginations. One family.</p></div><div class="team-grid">{credits.members.map(member => <article class="team-member" id={member.name.toLowerCase().replaceAll(' ', '-')}><StudioImage src={`/assets/team/${member.portrait.split('/').pop()}`} alt={`Illustrated studio portrait of ${member.name}`} width="512" height="512" loading="lazy" /><div class="member-copy"><h3>{member.name}</h3><p class="member-role">{member.role}</p><p>{member.bio}</p></div></article>)}</div></div></section>
</BaseLayout>
