---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioImage from '../components/StudioImage.astro';
import Arrow from '../components/Arrow.astro';
import { media } from '../data/media';
import { site } from '../config/site';
const categories = ['All', 'Artwork', 'Logos', 'Videos'];
---
<BaseLayout title="Trash Dash Artwork & Media — ReplayEveryMemory Studio" description="Explore the storyboards, character designs, environments, props, and artwork shaping Trash Dash, our first video game.">
  <section class="media-hero container"><h1>A little look<br />behind the game.</h1><p class="lede">Characters, artwork, and a world taking shape.<br />A collection from the making of Trash Dash.</p></section>
  <section class="container media-library" aria-label="Trash Dash media">
    <div class="media-origin" aria-labelledby="media-origin-title">
      <div><p class="media-origin-label">Where it began</p><h2 id="media-origin-title">It started with a raccoon.</h2></div>
      <div class="media-origin-story">
        <p>One morning before school, my daughter asked me what my favorite animal was. I chose a raccoon and began drawing little raccoons for her to color. We had been talking about Mario Party, and I thought, “What if we made a game of our own?” I sketched a few characters, then, after dropping her off, built a tiny browser platformer inspired by the games I grew up playing.</p>
        <p>The graphics and gameplay were simple, but the idea kept growing. As I learned new tricks and drew on a lifetime of games and storytelling, Trash Dash became more than a little experiment. Its story is still taking shape, and it is fun to look back at where the dream began. I cannot wait to share more of it soon.</p>
        <p class="media-origin-signature">— James</p>
      </div>
    </div>
    <div class="media-toolbar"><div class="media-filters" role="group" aria-label="Filter media" hidden>{categories.map(category => <button class="filter-button" type="button" data-filter={category} aria-pressed={category === 'All'}>{category}<span>{category === 'All' ? media.length : media.filter(item => item.category === category).length}</span></button>)}</div><p class="media-count" aria-live="polite" aria-atomic="true">{media.length} items</p></div>
    <div class="media-grid">{media.map(item => <article class="media-item" data-category={item.category}>
      {item.type === 'image' ? <div class:list={['media-image', `media-${item.presentation ?? 'default'}`]} data-artwork><StudioImage src={item.src} alt={item.alt} loading="lazy" /></div> : <div class="media-video" data-artwork><video controls controlslist="nodownload" preload="metadata" poster={item.poster} aria-label={item.title}><source src={item.src} />{item.captions && <track kind="captions" src={item.captions} srclang="en" label="English" default />}Your browser cannot play this video. Please try a newer browser.</video></div>}
      <div class="media-item-info"><div><h2>{item.title}</h2><p>{item.description}</p>{item.type === 'image' && <button class="text-link media-open" type="button" data-view-artwork aria-label={`View ${item.title}`} aria-haspopup="dialog" hidden>View artwork <Arrow /></button>}</div></div>
    </article>)}</div>
    <p class="media-rights">Artwork and assets are for viewing only. Studio use only; no downloading, copying, or reuse without permission.</p>
    <p class="media-note">Development artwork includes early ideas and earlier studio branding. Final game details may change.</p>
    <div class="media-empty" hidden><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="5" y="10" width="28" height="28" rx="5" stroke="currentColor" stroke-width="2" /><path d="m33 20 10-6v20l-10-6" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg><h2>Still in the making.</h2><p>More from the making of Trash Dash is on its way.</p><a class="text-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Follow along on Instagram <Arrow /><span class="sr-only"> (opens in a new tab)</span></a></div>
  </section>
  <dialog class="artwork-viewer" aria-labelledby="artwork-viewer-title" aria-describedby="artwork-viewer-rights">
    <div class="artwork-viewer-heading"><h2 id="artwork-viewer-title">Artwork</h2><button type="button" class="viewer-close" aria-label="Close artwork viewer" autofocus>Close <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" /></svg></button></div>
    <img class="artwork-viewer-image" alt="" draggable="false" />
    <p id="artwork-viewer-rights">© ReplayEveryMemory Studio. Viewing only. No copying or reuse without permission.</p>
  </dialog>
</BaseLayout>
<script>
  const viewer = document.querySelector<HTMLDialogElement>('.artwork-viewer');
  const preview = viewer?.querySelector<HTMLImageElement>('.artwork-viewer-image');
  const title = viewer?.querySelector<HTMLElement>('#artwork-viewer-title');
  if (viewer && preview && title && typeof viewer.showModal === 'function') {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-view-artwork]')) {
      button.hidden = false;
      button.addEventListener('click', () => {
        const item = button.closest('.media-item');
        const image = item?.querySelector('img');
        if (!image) return;
        preview.src = image.currentSrc || image.src;
        preview.alt = image.alt;
        title.textContent = item?.querySelector('h2')?.textContent || 'Artwork';
        viewer.showModal();
      });
    }
    viewer.querySelector('.viewer-close')?.addEventListener('click', () => viewer.close());
    viewer.addEventListener('click', event => {
      const bounds = viewer.getBoundingClientRect();
      if (event.target === viewer && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) viewer.close();
    });
    viewer.addEventListener('close', () => preview.removeAttribute('src'));
  }
  const filters = document.querySelector<HTMLElement>('.media-filters');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('.media-item')];
  const count = document.querySelector<HTMLElement>('.media-count');
  const empty = document.querySelector<HTMLElement>('.media-empty');
  const note = document.querySelector<HTMLElement>('.media-note');
  if (filters) filters.hidden = false;
  for (const button of buttons) button.addEventListener('click', () => {
    const category = button.dataset.filter;
    for (const candidate of buttons) candidate.setAttribute('aria-pressed', String(candidate === button));
    let visible = 0;
    for (const item of items) { item.hidden = category !== 'All' && item.dataset.category !== category; if (!item.hidden) visible++; }
    if (count) count.textContent = `${visible} ${visible === 1 ? 'item' : 'items'}${category === 'All' ? '' : ` in ${category?.toLowerCase()}`}`;
    if (empty) empty.hidden = visible > 0;
    if (note) note.hidden = category === 'Logos' || category === 'Videos';
  });
</script>
