---
import StudioImage from '../components/StudioImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredGame } from '../data/games';
import Arrow from '../components/Arrow.astro';
import TrashyArt from '../components/TrashyArt.astro';
import ForestScene from '../components/ForestScene.astro';
---
<BaseLayout title="ReplayEveryMemory Studio — Dreams with a start button" description="A homegrown, family-powered game studio. We’re turning a lifelong love of play into worlds of our own, starting with Trash Dash.">
  <section class="studio-hero" aria-labelledby="home-title">
    <div class="container studio-hero-main">
      <div class="studio-hero-copy">
        <h1 id="home-title">Dreams with<br />a <span>start button.</span></h1>
        <p>We’re ReplayEveryMemory Studio. A small, family-powered studio making the games we’ve always dreamed of playing.</p>
        <div class="actions"><a class="button button-gold" href="/about#team">Meet the team <Arrow /></a><a class="text-link" href="/games">Meet Trash Dash <Arrow /></a></div>
      </div>
      <div class="studio-emblem" aria-hidden="true">
        <svg class="emblem-orbits" viewBox="0 0 520 520" fill="none"><circle cx="260" cy="260" r="245" /><circle cx="260" cy="260" r="209" /><path d="M9 260h38m426 0h38M260 9v38m0 426v38" /><circle class="orbit-spark" cx="430" cy="85" r="6" /><path class="emblem-star" d="M84 93v26m-13-13h26M429 394v18m-9-9h18" /></svg>
        <StudioImage src="/assets/studio-mark.png" alt="" previewWidth={850} loading="eager" />
      </div>
    </div>
    <div class="container studio-hero-foot"><p>Homegrown games. Wholehearted adventures.</p><a href="#our-work">See what we’re making <Arrow /></a></div>
  </section>
  <section class="home-project section" id="our-work" aria-labelledby="game-heading">
    <div class="container project-heading"><h2 id="game-heading">Our first adventure.<br /><span>Anything but ordinary.</span></h2><p>A little raccoon. A big heart.<br />A world worth looking after.</p></div>
    <div class="container project-window" id="trash-dash">
      <ForestScene />
      <div class="project-window-title"><a href="/games" aria-label="Get to know Trash Dash"><StudioImage src={featuredGame.logo} alt="Trash Dash" previewWidth={650} loading="lazy" /></a><span>Our first game · {featuredGame.status}</span></div>
      <div class="project-character"><TrashyArt /></div>
      <div class="project-window-bottom"><span>Step into Trashy’s world.</span><a href="/games" class="button button-gold">Meet Trash Dash <Arrow /></a></div>
    </div>
    <div class="container project-summary"><p>{featuredGame.summary}</p><a class="text-link" href="/games">Get to know Trash Dash <Arrow /></a></div>
  </section>
  <section class="home-story section" aria-labelledby="story-heading">
    <div class="container story-layout">
      <div class="story-title"><h2 id="story-heading">Big dreams.<br />Rolled-up<br /><span>sleeves.</span></h2><p>That’s how we’re getting started.</p></div>
      <div class="story-copy"><p class="lede">Some dreams stay in a notebook.<br />We’re giving ours a start button.</p><p>ReplayEveryMemory grew from a love of games and a simple thought: what if we made one of our own? So here we are—dreaming up worlds, figuring things out, and making something together.</p><p>We’re a family of makers, storytellers, and enthusiastic “what if?” askers. We bring our different imaginations to the same adventure, with a hands-on, learn-as-we-go spirit.</p><p>Trash Dash is where our story begins. The heart behind it—curiosity, care, and the joy of creating—is what we’ll carry into everything we make next.</p><a class="text-link" href="/about">A little more about us <Arrow /></a></div>
    </div>
    <div class="container studio-note"><span>Made with imagination.</span><svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 4v32M4 20h32M9 9l22 22M9 31 31 9" stroke="currentColor" stroke-width="2" /></svg><span>Built with heart.</span></div>
  </section>
</BaseLayout>
