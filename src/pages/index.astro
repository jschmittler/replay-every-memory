---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import TrashyArt from '../components/TrashyArt.astro';
import credits from '../data/studio-team.json';
import { site } from '../config/site';
const family = credits.members.slice(0, 4);
---
<BaseLayout title="ReplayEveryMemory Studio — Dreams with a start button" description="Replay Every Memory is making Trash Dash, a 2D side-scrolling adventure about Trashy, Jimothy, and the Gunk.">
  <section class="home-hero"><div class="container hero-grid">
    <div class="hero-copy"><h1>Dreams with<br />a start button.</h1><p>We’re ReplayEveryMemory Studio. A homegrown game studio making new adventures from a lifelong love of play.</p><div class="actions"><a class="button" href="#trash-dash">Meet Trash Dash <Arrow /></a><a class="text-link" href="/about">Meet the studio <Arrow /></a></div></div>
    <div class="hero-art"><div class="hero-orbit" aria-hidden="true"></div><TrashyArt eager /><div class="character-note"><span class="note-line" aria-hidden="true"></span><span>Big heart.<br />Excellent trash radar.</span></div></div>
  </div><div class="container hero-bottom"><p>New worlds. Familiar feeling.</p><a href="#trash-dash">Our first adventure <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a></div></section>
  <section class="section game-section" id="trash-dash" aria-labelledby="game-heading"><div class="container game-grid">
    <div class="game-copy"><h2 id="game-heading">A little raccoon.<br />A big adventure.</h2><p class="lede">Meet Trash Dash, our 2D side-scrolling adventure.</p><p>When the purple-black Gunk begins corrupting the animals around Trashy’s forest home, he and his best friend Jimothy follow it beyond the woods to help the creatures caught in it. Their journey moves from forest to suburbia to city.</p><p>It’s a character-driven, humorous adventure where infected animals are victims, not disposable enemies.</p><p class="development-status"><span aria-hidden="true"></span>In development · Launching in 2026</p><p class="platforms">Planned for Steam, the App Store, and Google Play.</p><a class="text-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Follow development on Instagram <Arrow /><span class="sr-only"> (opens in a new tab)</span></a></div>
    <a class="game-poster" href="/media" aria-label="Explore Trash Dash artwork"><img src="/assets/trash-dash-logo.svg" width="2049" height="869" alt="Trash Dash" loading="lazy" /><div class="poster-caption"><span>Our first adventure is taking shape.</span><span class="round-arrow"><Arrow /></span></div></a>
  </div></section>
  <section class="studio-section section" aria-labelledby="studio-heading"><div class="container studio-intro"><div><h2 id="studio-heading">Dreams with<br />a start button.</h2></div><div><p class="lede">Replay Every Memory is making games to remember.</p><p>We’re an independent studio centered on playful worlds, expressive characters, and the small details that make an adventure feel personal.</p><a class="text-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Behind the scenes on Instagram <Arrow /><span class="sr-only"> (opens in a new tab)</span></a></div></div>
    <div class="container family-strip">{family.map(member => <a class="family-preview" href={`/about#${member.name.toLowerCase()}`}><img src={`/assets/team/${member.portrait.split('/').pop()}`} alt={`Studio portrait of ${member.name}`} width="512" height="512" loading="lazy" /><div><h3>{member.name}</h3><span>{member.role}</span></div></a>)}</div>
  </section>
</BaseLayout>
