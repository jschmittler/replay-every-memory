---
import StudioImage from './StudioImage.astro';
interface Props { character: 'trashy' | 'jimothy'; eager?: boolean; alt?: string; }
const { character, eager = false, alt } = Astro.props;
// Measured visible artwork bounds plus 32px breathing room, leaving originals intact.
const figures = {
  trashy: { src: '/assets/trashy.png', alt: 'Trashy standing in his gold bandana, blue trousers, and utility belt.', imageWidth: 2244, left: 545, top: 716, width: 1067, height: 1280 },
  jimothy: { src: '/assets/characters/jimothy.png', alt: 'Jimothy’s full standing pose, with his teal scarf, striped tail, and both feet visible.', imageWidth: 2396, left: 618, top: 640, width: 957, height: 1345 },
};
const figure = figures[character];
---
<div class:list={['standing-character', `standing-character--${character}`]} style={`--figure-ratio:${figure.width / figure.height};aspect-ratio:${figure.width}/${figure.height}`}>
  <StudioImage src={figure.src} alt={alt ?? figure.alt} previewWidth={1440} loading={eager ? 'eager' : 'lazy'} style={`width:${figure.imageWidth / figure.width * 100}%;left:${-figure.left / figure.width * 100}%;top:${-figure.top / figure.height * 100}%`} />
</div>
