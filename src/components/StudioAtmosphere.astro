<canvas class="studio-atmosphere" aria-hidden="true"></canvas>
<script>
  // A bounded, cursor-responsive field spanning the hero behind the unchanged studio mark and copy.
  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('.studio-atmosphere')) {
    const context = canvas.getContext('2d');
    const stage = canvas.closest<HTMLElement>('.studio-hero');
    if (!context || !stage) continue;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const pointer = matchMedia('(hover: hover) and (pointer: fine)');
    const particles = Array.from({ length: 80 }, (_, i) => ({
      angle: i * 2.39996, left: .03 + ((i * .618034) % 1) * .94, top: .08 + ((i * .381966 + i * i * .013) % 1) * .8,
      size: .65 + (i % 4) * .35, speed: .045 + (i % 5) * .008,
    }));
    let width = 0, height = 0, frame = 0, last = 0, time = 0, activeUntil = 0;
    let visible = false, greeted = false;
    let x = 0, y = 0, targetX = 0, targetY = 0;
    function draw() {
      if (!context || !width || !height) return;
      context.clearRect(0, 0, width, height);
      context.globalCompositeOperation = 'screen';
      for (let i = 0; i < 4; i++) {
        const drift = Math.sin(time * .3 + i * 1.8) * height * .025;
        context.save();
        context.translate(width * (.3 + i * .18) + x * width * .025, height * (.35 + i * .1) + y * height * .04 + drift);
        context.rotate(-.6 + i * .3);
        context.scale(1, .35);
        const mist = context.createRadialGradient(0, 0, 0, 0, 0, width * .32);
        mist.addColorStop(0, i % 2 ? 'rgba(235,173,65,.1)' : 'rgba(82,170,155,.18)');
        mist.addColorStop(.45, 'rgba(62,127,126,.08)');
        mist.addColorStop(1, 'rgba(35,81,88,0)');
        context.fillStyle = mist;
        context.fillRect(-width * .35, -width * .35, width * .7, width * .7);
        context.restore();
      }
      for (const [i, p] of particles.entries()) {
        const angle = p.angle + time * p.speed;
        const px = width * (p.left + Math.cos(angle) * .015) + x * width * (.008 + p.top * .014);
        const py = height * (p.top + Math.sin(angle) * .025) + y * height * (.012 + p.left * .022);
        const alpha = (.24 + (Math.sin(time * .65 + i * 1.4) + 1) * .2) * (p.left < .5 ? .5 : 1);
        const radius = p.size * Math.min(width / 1100, 1.3);
        const glow = context.createRadialGradient(px, py, 0, px, py, radius * 6);
        glow.addColorStop(0, `rgba(255,214,130,${alpha})`);
        glow.addColorStop(.25, `rgba(247,190,88,${alpha * .28})`);
        glow.addColorStop(1, 'rgba(247,190,88,0)');
        context.fillStyle = glow;
        context.fillRect(px - radius * 6, py - radius * 6, radius * 12, radius * 12);
        context.fillStyle = `rgba(255,229,166,${alpha})`;
        context.beginPath(); context.arc(px, py, radius, 0, Math.PI * 2); context.fill();
      }
      context.globalCompositeOperation = 'source-over';
    }
    function stop() { cancelAnimationFrame(frame); frame = 0; last = 0; }
    function tick(now: number) {
      frame = 0;
      if (!visible || document.hidden || reduced.matches) return;
      const delta = last ? Math.min((now - last) / 1000, .05) : 0;
      last = now; time += delta;
      const ease = 1 - Math.exp(-delta * 5);
      x += (targetX - x) * ease; y += (targetY - y) * ease;
      draw();
      if (now < activeUntil) frame = requestAnimationFrame(tick);
      else last = 0;
    }
    function wake(duration: number) {
      if (!visible || document.hidden || reduced.matches) return;
      activeUntil = performance.now() + duration;
      if (!frame) frame = requestAnimationFrame(tick);
    }
    const resize = new ResizeObserver(() => {
      const bounds = canvas.getBoundingClientRect();
      width = bounds.width; height = bounds.height;
      const ratio = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      draw();
    });
    resize.observe(canvas);
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!visible) stop();
      else if (!greeted) { greeted = true; wake(4500); }
    });
    observer.observe(canvas);
    stage.addEventListener('pointermove', event => {
      if (!pointer.matches || reduced.matches) return;
      const bounds = canvas.getBoundingClientRect();
      targetX = Math.max(-1, Math.min(1, (event.clientX - bounds.left) / bounds.width * 2 - 1));
      targetY = Math.max(-1, Math.min(1, (event.clientY - bounds.top) / bounds.height * 2 - 1));
      wake(1200);
    });
    stage.addEventListener('pointerleave', () => { targetX = 0; targetY = 0; wake(1200); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    reduced.addEventListener('change', () => { stop(); x = y = targetX = targetY = 0; draw(); });
    document.addEventListener('astro:before-swap', () => { stop(); resize.disconnect(); observer.disconnect(); }, { once: true });
  }
</script>
