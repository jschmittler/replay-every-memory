---
import { site } from '../config/site';
import Arrow from './Arrow.astro';
---
<footer class="site-footer" id="hello">
  <div class="container contact-layout"><div><h2>Good memories<br />start with hello.</h2><p>Follow the making of Trash Dash, share a little encouragement, or just drop us a line.</p><p class="privacy-note">We keep this site simple and privacy-conscious: no ad pixels, behavioral tracking, or unnecessary cookies.</p></div><div class="contact-links">
    <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer"><span><small>Find us on Instagram</small><strong>{site.publicHandle}</strong></span><Arrow /><span class="sr-only"> (opens in a new tab)</span></a>
    <a href={`mailto:${site.publicEmail}`}><span><small>Send us an email</small><strong>{site.publicEmail}</strong></span><Arrow /></a>
  </div></div>
  <div class="container footer-bottom"><p>© {new Date().getFullYear()} ReplayEveryMemory Studio</p><nav aria-label="Footer navigation"><a href="/">Home</a><a href="/media">Media</a><a href="/about">About us</a></nav><span>Dreams with a start button.</span></div>
</footer>
