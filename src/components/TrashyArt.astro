---
import StudioImage from './StudioImage.astro';
import idleAnimation from '../assets/animation/trashy-idle.webm?url';
interface Props { decorative?: boolean; eager?: boolean; }
const { decorative = false, eager = false } = Astro.props;
const description = 'Trashy, our raccoon hero, wearing his golden bandana, framed from the belt up and looking into the woodland scene.';
---
<!-- Motion: loop the supplied idle artwork while it is in view. Keep
     a visible still by default; load only in view, pause when hidden, and honor
     reduced motion. A one-frame alpha check avoids opaque video backgrounds. -->
<div class="trashy-art" data-trashy-animation data-animation-src={idleAnimation} role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : description} aria-hidden={decorative ? 'true' : undefined}>
  <StudioImage src="/assets/trashy.png" width="2244" height="2804" alt="" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  <video class="trashy-idle" muted loop playsinline preload="none" controlslist="nodownload" disablepictureinpicture draggable="false" aria-hidden="true" tabindex="-1"></video>
</div>
<script>
  for (const art of document.querySelectorAll<HTMLElement>('[data-trashy-animation]')) {
    const video = art.querySelector<HTMLVideoElement>('video')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false;
    let loaded = false;
    let transparent = false;
    let failed = !video.canPlayType('video/webm; codecs="vp9"');
    video.muted = true;
    video.loop = true;

    function showStill() {
      delete art.dataset.videoReady;
    }

    function updatePlayback() {
      if (motion.matches || failed) { video.pause(); showStill(); return; }
      if (transparent) art.dataset.videoReady = 'true';
      if (!inView || document.hidden) { video.pause(); return; }
      if (!loaded) {
        video.src = art.dataset.animationSrc!;
        loaded = true;
      }
      void video.play().catch(() => {
        // A visibility change may interrupt play without a playback failure.
        if (inView && !document.hidden && !motion.matches) showStill();
      });
    }

    video.addEventListener('loadeddata', () => {
      // Some browsers decode VP9 but discard its alpha channel. Detect the
      // actual decoded frame, keeping the approved still in that case.
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 32; canvas.height = 24;
        const context = canvas.getContext('2d', { willReadFrequently: true });
        if (!context) throw new Error('No canvas context');
        context.drawImage(video, 0, 0, 32, 24);
        const pixels = context.getImageData(0, 0, 32, 24).data;
        transparent = [0, 31, 32 * 23, 32 * 24 - 1].some(pixel => pixels[pixel * 4 + 3] < 16);
        failed = !transparent;
      } catch { failed = true; }
      updatePlayback();
    });
    video.addEventListener('error', () => { failed = true; updatePlayback(); });
    motion.addEventListener('change', updatePlayback);
    document.addEventListener('visibilitychange', updatePlayback);
    const observer = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; updatePlayback(); }, { threshold: 0.05 });
    observer.observe(art);
  }
</script>
