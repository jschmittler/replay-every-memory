---
import '../styles/global.css';
import '../styles/studio.css';
import GameNav from '../components/GameNav.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import ArtworkViewing from '../components/ArtworkViewing.astro';
import { getImage } from 'astro:assets';
import studioFavicon from '../assets/studio-logo-favicon.png';
import studioLogo from '../assets/studio-logo.png';
import displayFontUrl from '../assets/fonts/eurostile-extended-black.ttf?url';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = site.siteUrl ? new URL(Astro.url.pathname, site.siteUrl).href : undefined;
const favicon = await getImage({ src: studioFavicon, width: 96, height: 96, format: 'png' });
const socialImage = site.siteUrl ? await getImage({ src: studioLogo, width: 1200, format: 'webp', quality: 82 }) : undefined;
---
<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#f7c75d" />
  {!site.siteUrl && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" type="image/png" sizes="96x96" href={favicon.src} />
  <link rel="preload" href={displayFontUrl} as="font" type="font/ttf" crossorigin />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
  {site.siteUrl && socialImage && <meta property="og:image" content={new URL(socialImage.src, site.siteUrl).href} />}
  <title>{title}</title>
</head><body>
  <!-- THESIS: A family studio turns shared imagination into playable worlds. OWN-WORLD: Official EuroStyle lettering, midnight navy, sunlit gold, sweeping studio insignia, cinematic woodland art, open story spreads. STORY: Meet the studio, discover its first game, connect with its makers. FIRST VIEWPORT: A broad navy stage pairs oversized cream and gold studio words with the official sun emblem; the gold Meet the team action leads. FORM: Studio opening titles, candidate 6, seed 4a6c511b; code-led execution of the owner's approved architecture and delegated creative direction. Signature motion: the restored atmospheric field surrounds the static studio mark, then Trashy's brief greeting brings the woodland feature to life. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
  <a class="skip-link" href="#main">Skip to content</a><Header /><main id="main"><GameNav /><slot /></main><Footer /><ArtworkViewing />
</body></html>
